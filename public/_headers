# Cabeceras para Cloudflare Pages / Netlify.
# Los assets llevan hash en el nombre, así que se cachean para siempre;
# el HTML se revalida en cada visita para que un despliegue nuevo se vea al momento.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
